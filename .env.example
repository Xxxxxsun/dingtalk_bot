# Copy to .env (chmod 600) and fill in. Never commit .env.

# 钉钉群 → 设置 → 机器人 → 添加机器人 → 自定义（Webhook），安全设置选“加签”
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_ACCESS_TOKEN
DINGTALK_SECRET=SECxxxxxxxxxxxxxxxx

# Claude Code 认证（二选一）。服务器上运行 `claude setup-token` 获取长期令牌。
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# 使用第三方中转 API 时（runner 不读取 ~/.claude/settings.json，需在此显式填写）：
# ANTHROPIC_BASE_URL=https://your-relay.example.com
# ANTHROPIC_AUTH_TOKEN=sk-...

# 周报（联网检索）用的模型；HF 摘要用的快速模型
MYCLAW_CLAUDE_MODEL=claude-opus-5-5
MYCLAW_CLAUDE_FAST_MODEL=claude-sonnet-5-5
# 单次 claude 调用的费用上限（美元，可选；仅对 API key 计费有意义）
# MYCLAW_MAX_BUDGET_USD=5

MYCLAW_TIMEZONE=Asia/Shanghai
# 国内服务器访问不了 huggingface.co 时使用镜像
# MYCLAW_HF_ENDPOINT=https://hf-mirror.com
# 仅用于抓取 Juya / HF 数据源的代理（不影响 Claude 与钉钉请求）
# MYCLAW_FETCH_PROXY=http://127.0.0.1:7890
# 任务失败时向群里发一条简短失败通知（1 开启）
MYCLAW_NOTIFY_FAILURES=0
# 可选：claude 路径与状态目录（默认 ~/.local/state/myclaw）
# MYCLAW_CLAUDE_BIN=<claude 可执行文件的绝对路径>
# MYCLAW_STATE_DIR=/absolute/path/to/state
